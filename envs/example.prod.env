# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
# 로컬에서 127.0.0.1로 접속하시는 분은, 이 example 파일 말고 본인 .env에서만
# COOKIE_DOMAIN=(빈 값)으로 바꿔서 쓰세요 - 팀 공통 기본값은 localhost로 유지합니다.
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=Password1234@
DB_ROOT_PASSWORD=Ozcoding1234@
DB_NAME=ai_health

# redis
REDIS_PORT=6379

# oauth (social login)
