# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# llm (T-LLM-2) — 비워두면 app/services/llm_stub.py가 고정 문자열 stub으로 동작한다
OPENAI_API_KEY=
OPENAI_EMBEDDING_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# RAG 임베딩 (T-LLM-7-4) — **비워둬도 된다.** 기본값(huggingface)은 모델을 로컬에
# 내려받아 색인도 질의도 직접 돌리므로 네트워크도 키도 과금도 없다. 최초 1회 약 2GB를
# 받고, 서빙 프로세스가 1.1GB를 물고 있는다.
#
# openai로 바꾸면 text-embedding-3-small을 쓴다(과금됨, OPENAI_EMBEDDING_API_KEY 필요).
# 바꾸면 벡터공간이 달라져 전체 재색인이 필요하다 — assert_embedding_compatible이 막는다.
EMBEDDING_PROVIDER=huggingface
# 아래는 RAG에 필요 없다. scripts/benchmark_embeddings.py(후보 모델 비교용 1회성 도구)만
# HF Inference API를 호출하므로, 그 벤치마크를 돌릴 때만 채우면 된다.
HUGGINGFACE_API_KEY=

# 공공데이터포털 (T-MED-4) — 비워두면 app/services/medication_open_api_client.py가 빈 리스트를 반환한다
PUBLIC_DATA_API_KEY=

# PubMed E-utilities (T-LLM-7-3) — 비워두면 키 없이 호출(3req/sec 제한)
PUBMED_API_KEY=


# FCM(Firebase Cloud Messaging) — 웹/네이티브 공통 발송 채널. Firebase 콘솔 > 프로젝트 설정 >
# 서비스 계정 > "새 비공개 키 생성"으로 받은 json을 app/secrets/firebase-service-account.json에
# 두고 경로를 넣는다. 비워두면 FCM 발송만 건너뛴다(웹푸시는 그대로 동작).
FIREBASE_CREDENTIALS_PATH=

# 건강정보 텍스트 필드 암호화 키 (개인정보보호법 제23조) — app/scripts/generate_field_encryption_key.py로
# 1회 생성 후 넣는다. 비워두면 평문 그대로 저장된다(로컬 개발 편의) - 배포 전 반드시 설정할 것.
FIELD_ENCRYPTION_KEY=


# db
DB_HOST=localhost
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=pw1234
DB_ROOT_PASSWORD=Password123@!
DB_NAME=ai_health
