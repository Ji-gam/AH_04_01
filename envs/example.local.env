# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# llm (T-LLM-2) — 비워두면 app/services/llm_stub.py가 고정 문자열 stub으로 동작한다
OPENAI_API_KEY=
OPENAI_EMBEDDING_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# RAG 임베딩 (T-LLM-7-4) — **RAG 색인/검색을 쓰려면 반드시 채워야 한다.**
# EMBEDDING_PROVIDER 기본값이 huggingface라, 이 키가 비면 EmbeddingUnavailableError로
# 즉시 실패한다(조용히 저하되는 대신 설정 오류로 드러내는 게 의도).
#
# 문서 임베딩(색인)은 모델을 로컬에 내려받아 돌리므로 과금이 없다. 이 키가 필요한 건
# 실시간 질의 임베딩(HF Inference API, 질문당 1건)이고 그것도 무료 티어다.
# 발급: https://huggingface.co/settings/tokens (read 권한이면 충분)
HUGGINGFACE_API_KEY=
# openai로 바꾸면 text-embedding-3-small을 쓴다(과금됨). 바꾸면 벡터공간이 달라져
# 전체 재색인이 필요하다 — assert_embedding_compatible이 불일치를 잡아 막는다.
EMBEDDING_PROVIDER=huggingface

# 공공데이터포털 (T-MED-4) — 비워두면 app/services/medication_open_api_client.py가 빈 리스트를 반환한다
PUBLIC_DATA_API_KEY=

# PubMed E-utilities (T-LLM-7-3) — 비워두면 키 없이 호출(3req/sec 제한)
PUBMED_API_KEY=

# db
DB_HOST=localhost
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=pw1234
DB_ROOT_PASSWORD=Password123@!
DB_NAME=ai_health
