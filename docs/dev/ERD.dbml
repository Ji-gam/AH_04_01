Table food_drug_categories {
  id int [pk, increment]
  category varchar(200) [not null]
  drug_class varchar(200) [not null]
  food_interaction text
  alcohol_interaction text
  source_page varchar(50)
}

Table food_drug_food_items {
  id int [pk, increment]
  category_id int [not null, ref: > food_drug_categories.id]
  food_name varchar(200) [not null]
  detail text [not null]
  polarity varchar(20) [not null, default: 'avoid']

  indexes {
    (category_id)
  }
}

Table food_drug_ingredients {
  id int [pk, increment]
  category_id int [not null, ref: > food_drug_categories.id]
  name_ko varchar(200)
  name_en varchar(200)

  indexes {
    (category_id)
    (name_en)
    (name_ko)
  }
}

Table food_drug_sources {
  id int [pk, increment]
  title varchar(200)
  publisher varchar(200)
  published varchar(50)
  url varchar(500)
  note text
  not_covered text
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table food_nutrition_cache {
  id bigint [pk, increment]
  query_name varchar(150) [not null, unique]
  results json [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table item_ingredient_map {
  id int [pk, increment]
  item_seq varchar(20) [not null]
  ingr_code varchar(20) [not null]
  ingr_name varchar(255)
  qnt varchar(50)
  ingd_unit_cd varchar(50)

  indexes {
    (ingr_code)
    (item_seq)
  }
}

Table medicine_recalls {
  id int [pk, increment]
  item_seq varchar(20)
  prduct text
  entrps varchar(255)
  rtrvl_resn text
  recall_command_date varchar(20)
  enfrc_yn varchar(5)
  rtrvl_cmmnd_dt text
  bizrno text
  std_cd text
  mapped_item_seq text

  indexes {
    (item_seq)
  }
}


